# rendimiento in its WSL distribution. It starts with nobody named: whoever
# opens the setup page (http://localhost:8080) with the setup token, picks
# where the code lives (GitHub, GitLab or Bitbucket) and authorizes it
# becomes the first administrator. Settings go in /etc/rendimiento/env, one
# NAME=value per line (ALLOWED_USERS=ana, ana@gitlab.com or
# ana@bitbucket.org still names first administrators ahead, for scripts).
[Unit]
Description=rendimiento: deploy any app; AI agents fix what breaks
After=containerd.service buildkit.service network-online.target
Wants=containerd.service buildkit.service network-online.target

[Service]
Environment=MODE=local
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
EnvironmentFile=-/etc/rendimiento/env
ExecStart=/usr/local/bin/rendimiento
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
